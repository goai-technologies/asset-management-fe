# Target PostgreSQL (after migration from Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goai_assets

# Source Supabase (for export only — get password from Supabase Dashboard → Database)
# Export uses the Supabase CLI (supabase db dump --linked), not a manual pg_dump URL.
# Prerequisites: install Supabase CLI, run `supabase login`, and link this repo
# (supabase/config.toml should contain your project_id).
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
