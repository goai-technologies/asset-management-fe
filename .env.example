# PostgreSQL (server-side only — never expose as VITE_*)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goai_assets
JWT_SECRET=change-me-in-production

# Express backend API (Vite exposes VITE_* to the browser)
VITE_API_URL=http://localhost:5001/api

# Frontend dev server port (Lovable/Vite default is often 8080)
# VITE_PORT=8080
